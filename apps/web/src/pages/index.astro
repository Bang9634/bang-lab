---
import Base from '../layouts/Base.astro';
const welcomeText = 'cd ~/';
const terminalText = "Hi, I'm a Software Engineer.";
---
<Base landing>
  <div class="welcome" aria-hidden="true">
    <span class="welcome-word" style={`--welcome-steps: ${welcomeText.length}; --welcome-width: calc(${welcomeText.length}ch - ${(welcomeText.length - 1) * 0.05}em)`}><span class="welcome-text">{welcomeText}</span></span>
  </div>

  <section id="top" class="screen terminal-screen" aria-label="첫 화면">
    <div class="terminal">
      <p class="terminal-caption" aria-hidden="true">whoami</p>
      <h1 class="terminal-line" aria-label={terminalText}>
        <span class="terminal-prompt" aria-hidden="true">bang@localhost:~$&nbsp;</span>
        <span class="terminal-output" aria-hidden="true"><span id="typed-text">{terminalText}</span><span class="terminal-cursor"></span></span>
      </h1>
    </div>
    <a class="scroll-cue" href="#about" aria-label="About 섹션으로 이동"><span>Scroll to explore</span><span aria-hidden="true">↓</span></a>
  </section>

  <section id="about" class="screen content-screen" aria-labelledby="about-title">
    <div class="section-content">
      <p class="section-label">01 / About</p>
      <h2 id="about-title">만들고, 이해하고.<br />한 걸음 더 깊이.</h2>
      <p class="section-description">저를 여기에 곧 소개할게요.</p>
    </div>
  </section>

  <section id="work" class="screen content-screen work-screen" aria-labelledby="work-title">
    <div class="section-content">
      <p class="section-label">02 / Work</p>
      <h2 id="work-title">작은 구현에서<br />시작하는 탐구.</h2>
      <p class="section-description">직접 구현한 작업물들을<br class="desktop-break" /> 곧 여기에 소개할게요.</p>
    </div>
  </section>

  <section id="contact" class="screen content-screen" aria-labelledby="contact-title">
    <div class="section-content">
      <p class="section-label">03 / Contact</p>
      <h2 id="contact-title">좋은 대화가<br />다음 시작이 되도록.</h2>
      <p class="section-description">연락처는 곧 여기에 소개할게요.</p>
    </div>
  </section>
</Base>

<script>
  const output = document.querySelector<HTMLElement>('#typed-text');
  const welcome = document.querySelector<HTMLElement>('.welcome');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const phrase = output?.textContent ?? '';
  let timer: ReturnType<typeof setTimeout>;
  let position = 0;
  let deleting = false;
  let ready = false;

  function schedule(delay: number) {
    clearTimeout(timer);
    timer = setTimeout(tick, delay);
  }

  function tick() {
    if (!output || !phrase || motion.matches || document.hidden) return;
    position += deleting ? -1 : 1;
    output.textContent = phrase.slice(0, position);
    if (position === phrase.length) {
      deleting = true;
      schedule(2400);
    } else if (position === 0) {
      deleting = false;
      schedule(650);
    } else {
      schedule(deleting ? 32 : 85);
    }
  }

  function syncMotion() {
    clearTimeout(timer);
    if (!output) return;
    if (motion.matches) {
      welcome?.remove();
      ready = true;
      output.textContent = phrase;
    } else {
      position = 0;
      deleting = false;
      output.textContent = '';
      if (ready && !document.hidden) schedule(450);
    }
  }

  syncMotion();
  // Match the CSS intro duration; the overlay itself does not depend on JavaScript.
  setTimeout(() => {
    welcome?.remove();
    ready = true;
    if (!motion.matches && !document.hidden) schedule(250);
  }, 2200);
  motion.addEventListener('change', syncMotion);
  document.addEventListener('visibilitychange', () => {
    clearTimeout(timer);
    if (!document.hidden && ready && !motion.matches) schedule(350);
  });
  window.addEventListener('pagehide', () => clearTimeout(timer));
  window.addEventListener('pageshow', (event) => {
    // A back-forward cache restore does not rerun this script.
    if (event.persisted && ready && !motion.matches && !document.hidden) schedule(350);
  });
</script>
